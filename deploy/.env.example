# Copie para deploy/.env NA VPS e preencha. Este arquivo nunca vai para o Git.

# Endereço do app, sem https:// (o registro DNS precisa apontar para a VPS).
APP_DOMAIN=ninho.whapro.digital

# Senha do Postgres do Ninho. Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# Segredo das sessões, pelo menos 32 caracteres. Gere com: openssl rand -hex 32
SESSION_SECRET=

# E-mail (confirmação de cadastro e recuperação de senha) pelo Resend.
# Sem estes dois, ninguém consegue terminar o cadastro.
RESEND_API_KEY=
# Remetente de um domínio verificado no Resend, por exemplo: Ninho <ola@ninho.whapro.digital>
RESEND_FROM_EMAIL=

# Opcionais
LOG_LEVEL=info
IMAGE_TAG=latest
