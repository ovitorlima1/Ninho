# Copy to .env for local development: cp .env.example .env

# Postgres from docker-compose.dev.yml
DATABASE_URL=postgres://ninho:ninho@localhost:5460/ninho

# At least 32 characters. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Local ports (8080 and 5173 are often taken by other projects)
API_PORT=8787
WEB_PORT=5180

LOG_LEVEL=info

# E-mail (confirmação de cadastro e recuperação de senha).
# Sign-up only finishes through the link in the e-mail. Locally, Resend (via
# Replit Connectors) does not work: use EMAIL_TRANSPORT=log and copy the link
# from the API log. "log" and "outbox" are refused in production.
EMAIL_TRANSPORT=log
# Outside production, http://localhost is accepted; in production it must be HTTPS.
PUBLIC_APP_URL=http://localhost:5180
# RESEND_FROM_EMAIL=Ninho <no-reply@example.com>
